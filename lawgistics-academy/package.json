{
  "name": "lawgistics-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:push": "supabase db push",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "test:db": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/schema-guarantees.sql",
    "qa:devices": "node tools/visual-qa/device-check.mjs",
    "qa:site": "node tools/site-qa/device-check.mjs",
    "qa:a11y": "node tools/site-qa/a11y-check.mjs",
    "qa:mock": "node tools/visual-qa/mock-supabase.mjs",
    "review:pack": "tsx --conditions=react-server scripts/review-pack.ts",
    "doctor": "tsx --conditions=react-server scripts/doctor.ts",
    "build:sql": "tsx scripts/build-combined-sql.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "dotenv": "^16.4.7",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
