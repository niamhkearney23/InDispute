# --- Supabase ---------------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. NEVER prefix this with NEXT_PUBLIC_ and never commit it.
# It bypasses Row Level Security. Used for grading answers and seeding.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. If set, the first-run /setup page asks for this before it will grant
# administrator rights. Worth setting on any deployment that is publicly
# reachable before you have had a chance to claim it.
# SETUP_TOKEN=

# --- Branding (entirely optional) -------------------------------------------
# Leave these unset and it is Litigation Academy. Set them and the deployment
# is the firm's: their name in the wordmark, the page titles, the tab icon and
# the footer. Nothing here is secret, it is the name on the door, which is why
# these are NEXT_PUBLIC_. They are read at build time, so a change needs a
# redeploy rather than a restart.
#
# This is one firm per deployment: their own Vercel project, their own Supabase
# project, their people and their results in a database nobody else is in.
# NEXT_PUBLIC_BRAND_NAME=Thomas Philip
# NEXT_PUBLIC_BRAND_SUFFIX=Academy
# NEXT_PUBLIC_BRAND_TAGLINE=Malaysian litigation training.
# Six-digit hex, with or without the hash. Anything else is ignored and the
# built-in burgundy stays. Write it without the hash in this file: an unquoted
# # opens a comment here, so NEXT_PUBLIC_BRAND_ACCENT=#1f3a6b reads as empty.
# In Vercel's settings screen either form is fine.
# NEXT_PUBLIC_BRAND_ACCENT=1f3a6b

# --- Automation (entirely optional) -----------------------------------------
# A bearer token for GET /api/digest, a read-only summary of who is joining and
# what is outstanding, for n8n or anything similar.
#
# Leave it unset and the route returns 404: a deployment that has never heard of
# n8n does not expose a list of everybody joining the firm. Must be at least 24
# characters or it stays off. Generate one and never reuse it elsewhere:
#
#   openssl rand -base64 32
#
# This is a secret. It is not NEXT_PUBLIC_, it is read on the server only, and
# anybody holding it can read the names, addresses and start dates of everybody
# joining. It cannot write anything, and it cannot reach the question bank, the
# answers or anybody's results.
# DIGEST_TOKEN=

# --- AI coach (entirely optional) -------------------------------------------
# Leave AI_PROVIDER=none and the app runs exactly as it does with AI enabled,
# minus the generated commentary. Nothing in the core loop depends on it.
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_MODEL=claude-sonnet-4-6
