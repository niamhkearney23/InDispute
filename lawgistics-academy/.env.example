# --- Supabase ---------------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. NEVER prefix this with NEXT_PUBLIC_ and never commit it.
# It bypasses Row Level Security. Used for grading answers and seeding.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. If set, the first-run /setup page asks for this before it will grant
# administrator rights. Worth setting on any deployment that is publicly
# reachable before you have had a chance to claim it.
# SETUP_TOKEN=

# --- AI coach (entirely optional) -------------------------------------------
# Leave AI_PROVIDER=none and the app runs exactly as it does with AI enabled,
# minus the generated commentary. Nothing in the core loop depends on it.
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_MODEL=claude-sonnet-4-6
