{%- comment -%}
  Occasion landing hero, used by the Birthdays page. Built as a section so
  further occasions reuse it without new code.
{%- endcomment -%}

{{ 'sleep-shop.css' | asset_url | stylesheet_tag }}
{% render 'ss-tokens' %}

<div class="ss-occasion-hero">
  <div class="ss-occasion-hero__copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ss-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="ss-h2" style="font-size:2.3rem">{{ section.settings.heading }}</h1>
    {%- if section.settings.script != blank -%}
      <p class="ss-script" style="color:var(--ss-oxblood);margin:0 0 1rem">{{ section.settings.script }}</p>
    {%- endif -%}
    <div class="ss-body">{{ section.settings.body }}</div>
    {%- if section.settings.link_label != blank -%}
      <p style="margin-top:1.8rem">
        <a class="ss-btn" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
      </p>
    {%- endif -%}
  </div>

  <div class="ss-occasion-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '600, 900, 1200, 1600',
          sizes: '(min-width: 750px) 50vw, 100vw',
          alt: section.settings.image_alt | default: section.settings.heading
      }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Occasion hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "script", "label": "Script line", "info": "One phrase only." },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "text", "id": "link_label", "label": "Button label" }
  ]
}
{% endschema %}
