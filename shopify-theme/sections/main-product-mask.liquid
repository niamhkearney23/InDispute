{%- comment -%}
  Mask product page.

  Same spine as the box page, three differences that matter:

  1. A colour option, swapped client side. One option with a few values does
     not justify a server round trip per change.
  2. The gift message is opt in behind a checkbox rather than always open. A
     mask is often bought for the buyer, and an empty message field on every
     order is a field people feel obliged to fill.
  3. A line back to the box, because the mask is how most people will find us
     and the box is the thing worth buying twice.
{%- endcomment -%}

{{ 'sleep-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gift-message.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'variant-picker.js' | asset_url }}" defer="defer"></script>
{% render 'ss-tokens' %}

{%- assign variant = product.selected_or_first_available_variant -%}

<div class="ss-wrap">
  <div class="ss-product" data-variant-root data-money-format="{{ shop.money_format | escape }}">

    <div class="ss-gallery" role="group" aria-label="{{ product.title | escape }}, product images">
      {%- for media in product.media -%}
        <figure class="ss-gallery__item">
          {%- if media.media_type == 'image' -%}
            {{
              media
              | image_url: width: 1400
              | image_tag:
                loading: forloop.first ? 'eager' : 'lazy',
                fetchpriority: forloop.first ? 'high' : 'auto',
                widths: '400, 600, 800, 1000, 1400',
                sizes: '(min-width: 990px) 46vw, 86vw',
                alt: media.alt | default: product.title
            }}
          {%- else -%}
            {{ media | media_tag }}
          {%- endif -%}
          <span class="ss-gallery__count" aria-hidden="true">{{ forloop.index }}/{{ forloop.length }}</span>
        </figure>
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'ss-gallery__item' }}
      {%- endfor -%}
    </div>

    <div class="ss-product__buy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ss-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="ss-buy__title">{{ product.title }}</h1>

      {%- if section.settings.subtitle != blank -%}
        <p class="ss-buy__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      <div class="ss-price">
        <span data-variant-price>{{ variant.price | money }}</span>
        <span class="ss-price__gst">AUD, GST included</span>
      </div>

      {%- if variant.price >= 3000 -%}
        <p class="ss-instalment">
          or 4 instalments of <b data-instalment>{{ variant.price | divided_by: 4 | money }}</b> with Afterpay
        </p>
      {%- endif -%}

      {%- if product.description != blank -%}
        <div class="ss-body" style="margin-top:1rem">{{ product.description }}</div>
      {%- endif -%}

      {%- form 'product', product, id: 'ss-mask-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ variant.id }}">

        {%- comment -%}
          One option only. If a mask ever needs a second, this falls back to
          Dawn's own picker rather than pretending to handle it.
        {%- endcomment -%}
        {%- if product.has_only_default_variant == false and product.options.size == 1 -%}
          <fieldset class="ss-field" style="border:0;padding:0;margin-top:1.6rem">
            <legend class="ss-field__label">
              {{ product.options.first }}: <span data-variant-label>{{ variant.title }}</span>
            </legend>
            <div class="ss-swatches">
              {%- for option_variant in product.variants -%}
                <label class="ss-swatch {% unless option_variant.available %}ss-swatch--out{% endunless %}">
                  <input
                    type="radio"
                    name="variant-option"
                    value="{{ option_variant.id }}"
                    {% if option_variant.id == variant.id %}checked{% endif %}
                    {% unless option_variant.available %}disabled{% endunless %}
                  >
                  <span>{{ option_variant.title }}</span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endif -%}

        {%- if section.settings.show_gift_message -%}
          <div class="ss-field" style="margin-top:1.6rem">
            <label class="ss-optin">
              <input type="checkbox" data-gift-toggle aria-controls="ss-mask-gift">
              <span>Sending this as a gift</span>
            </label>
            <div id="ss-mask-gift" hidden>
              {% render 'gift-message-field' %}
            </div>
          </div>
        {%- endif -%}

        {% render 'dispatch-estimate' %}

        <button
          type="submit"
          name="add"
          class="ss-atc"
          data-atc
          data-label-available="Add to cart,"
          data-label-sold="Currently unavailable"
          {% unless variant.available %}disabled{% endunless %}
        >
          {%- if variant.available -%}Add to cart, {{ variant.price | money }}{%- else -%}Currently unavailable{%- endif -%}
        </button>

        <script type="application/json" data-variants>
          [
            {%- for v in product.variants -%}
              {"id": {{ v.id }}, "title": {{ v.title | json }}, "price": {{ v.price }}, "available": {{ v.available }}}
              {%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        </script>
      {%- endform -%}

      {% render 'reassurance-row' %}

      <div class="ss-accordions">
        {%- for block in section.blocks -%}
          {%- if block.settings.heading != blank -%}
            <details class="ss-accordion" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}</summary>
              <div class="ss-accordion__body">{{ block.settings.body }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.box_link_text != blank -%}
        <p class="ss-crossnote">
          {{ section.settings.box_link_text }}
          <a href="{{ section.settings.box_link }}">{{ section.settings.box_link_label }}</a>
        </p>
      {%- endif -%}
    </div>

  </div>
</div>

<script>
  /* The gift message stays out of the DOM flow until it is asked for, so the
     field cannot be submitted by someone who never opened it. */
  document.addEventListener('change', function (event) {
    if (!event.target.matches('[data-gift-toggle]')) return;
    var panel = document.getElementById(event.target.getAttribute('aria-controls'));
    if (!panel) return;
    panel.hidden = !event.target.checked;
    if (!event.target.checked) {
      var field = panel.querySelector('textarea');
      if (field) field.value = '';
    } else {
      var focusable = panel.querySelector('textarea');
      if (focusable) focusable.focus();
    }
  });
</script>

{% schema %}
{
  "name": "Mask buy box",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "info": "Script face. One short phrase." },
    { "type": "checkbox", "id": "show_gift_message", "label": "Offer a gift message", "default": true },
    { "type": "text", "id": "box_link_text", "label": "Cross sell text" },
    { "type": "url", "id": "box_link", "label": "Cross sell link" },
    { "type": "text", "id": "box_link_label", "label": "Cross sell link label" }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    }
  ]
}
{% endschema %}
