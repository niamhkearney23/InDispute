{%- comment -%}
  Founder story teaser. Short by design: it is a doorway to About, not the
  story itself.
{%- endcomment -%}

{{ 'sleep-shop.css' | asset_url | stylesheet_tag }}
{% render 'ss-tokens' %}

<div class="ss-section ss-section--cocoa">
  <div class="ss-wrap">
    <div class="ss-split {% if section.settings.flip %}ss-split--flip{% endif %}">
      <div class="ss-split__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1200',
              sizes: '(min-width: 750px) 46vw, 92vw',
              alt: section.settings.image_alt | default: section.settings.heading
          }}
        {%- endif -%}
      </div>

      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="ss-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.quote != blank -%}
          <p class="ss-script" style="color:var(--ss-cream);margin:0 0 1rem">
            {{ section.settings.quote }}
          </p>
        {%- endif -%}
        <div class="ss-body">{{ section.settings.body }}</div>

        {%- if section.settings.link_label != blank -%}
          <p style="margin-top:1.6rem">
            <a class="ss-btn ss-btn--ghost" href="{{ section.settings.link | default: '/pages/about' }}">
              {{ section.settings.link_label }}
            </a>
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Founder teaser",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "quote", "label": "Pull quote", "info": "Set in the script face. One phrase only." },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "checkbox", "id": "flip", "label": "Image on the right", "default": false }
  ]
}
{% endschema %}
