{%- comment -%}
  FAQ as accordions. Questions are headings so they can be linked and read by
  a screen reader in order.
{%- endcomment -%}

{{ 'sleep-shop.css' | asset_url | stylesheet_tag }}
{% render 'ss-tokens' %}

<div class="ss-section">
  <div class="ss-wrap" style="max-width:780px">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ss-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="ss-h2" style="font-size:2.1rem">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.intro != blank -%}
      <div class="ss-body" style="margin-bottom:2rem">{{ section.settings.intro }}</div>
    {%- endif -%}

    <div class="ss-accordions">
      {%- for block in section.blocks -%}
        <details class="ss-accordion" {{ block.shopify_attributes }} {% if forloop.first %}open{% endif %}>
          <summary>{{ block.settings.question }}</summary>
          <div class="ss-accordion__body">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "intro", "label": "Intro" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ]
}
{% endschema %}
