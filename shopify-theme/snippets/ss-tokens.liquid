{%- comment -%}
  Brand tokens from theme settings, so a colour change in the customiser
  reaches every section without a code deploy. The stylesheet carries the same
  values as fallbacks, so clearing a setting degrades rather than breaks.

  The typefaces load from here too. Every Sleep Shop section renders this
  snippet, so there is no section that can be added later which quietly falls
  back to Times New Roman.
{%- endcomment -%}
{% render 'ss-fonts' %}
<style>
  :root {
    --ss-cocoa: {{ settings.ss_cocoa | default: '#3B2318' }};
    --ss-rose: {{ settings.ss_rose | default: '#7A4A52' }};
    --ss-powder: {{ settings.ss_powder | default: '#AFC9DF' }};
    --ss-cream: {{ settings.ss_cream | default: '#F2E9DC' }};
    --ss-linen: {{ settings.ss_linen | default: '#FBF7F1' }};
  }
  body { background: var(--ss-linen); }
</style>
<script>
  /* Sections surface as the reader reaches them. Runs once however many
     sections render this snippet, only ever removes the veil, and stands
     down for reduced motion. */
  (function () {
    if (window.__ssReveal) return;
    window.__ssReveal = true;
    var arm = function () {
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (!('IntersectionObserver' in window)) return;
      document.documentElement.classList.add('ss-js');
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('ss-in-view');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.ss-section > .ss-wrap').forEach(function (el) {
        if (el.getBoundingClientRect().top > window.innerHeight * 0.9) {
          el.classList.add('ss-reveal');
          observer.observe(el);
        }
      });
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', arm);
    } else {
      arm();
    }
  })();
</script>
